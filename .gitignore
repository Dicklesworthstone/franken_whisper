*[tT][rR][aA][nN][sS][cC][rR][iI][pP][tT]*.[tT][sS][vV]

# Raw decoder/performance text is never a repository artifact. Retain only
# aggregate Markdown/JSON evidence; keep spans and decoded text outside Git.
tests/artifacts/perf/**/*.spans
tests/artifacts/perf/**/*_if.txt
tests/artifacts/perf/**/*_seq.txt
tests/artifacts/perf/**/*sample*.txt
tests/artifacts/perf/**/*spans*.txt
tests/artifacts/perf/**/*spans*.jsonl
# Permanently keep the retired local scale evaluation corpus out of Git,
# including aliases whose names do not reveal that they contain decoded text.
tests/artifacts/perf/20260606T2341Z-scale-baseline/


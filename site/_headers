# Response headers for the franken_whisper site (Cloudflare Pages).
#
# connect-src 'self' is load-bearing product copy: the hero promises audio
# never leaves the tab, and model weights arrive through the same-origin
# /model/* proxy (functions/model/[[path]].js), so the browser enforces the
# promise. COOP/COEP stay on so the future threaded wasm build needs no
# headers migration. `no-cache` pairs with the ?v=@SITEV@ stamp in deploy.sh —
# CDN zone TTL overrides can ignore origin no-cache, so the stamp is the real
# freshness mechanism.

/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/demo.html
  Cache-Control: no-cache

/app.js
  Cache-Control: no-cache

/chrome.js
  Cache-Control: no-cache

/engine-worker.js
  Cache-Control: no-cache

/loader.js
  Cache-Control: no-cache

/sha256.js
  Cache-Control: no-cache

/model-manifest.js
  Cache-Control: no-cache

# The wasm modules + JS glue rotate via the ?v= stamp; no-cache keeps
# revalidation honest even where the stamp is bypassed. worker-src blob: above
# exists for the threaded lane: wasm-bindgen-rayon's no-bundler helper spawns
# its pool workers from a blob URL.
/pkg/*
  Cache-Control: no-cache

/pkg-threaded/*
  Cache-Control: no-cache

# The model proxy serves immutable pinned release assets (cache-control is
# set by the function itself; this block documents intent).

/assets/css/site.css
  Cache-Control: public, max-age=86400

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/img/*
  Cache-Control: public, max-age=604800

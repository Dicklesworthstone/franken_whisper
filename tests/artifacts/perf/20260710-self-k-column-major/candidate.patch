+
+fn bench_self_attn_column_keys(c: &mut Criterion) {
+    use franken_whisper::native_engine::nn::{KvCache, attention_with_cache};
+
+    const N_STATE: usize = 1280;
+    const N_HEAD: usize = 20;
+    const CAPACITY: usize = 224;
+    const PREFILL: usize = CAPACITY - 1;
+    const PAIRED_REPS: usize = 25;
+
+    let mut lcg = Lcg::new(0xc011_0a7e);
+    let prefill_k = Mat::from_vec(
+        PREFILL,
+        N_STATE,
+        (0..PREFILL * N_STATE)
+            .map(|_| 0.1 * lcg.next_f32())
+            .collect(),
+    );
+    let prefill_v = Mat::from_vec(
+        PREFILL,
+        N_STATE,
+        (0..PREFILL * N_STATE)
+            .map(|_| 0.1 * lcg.next_f32())
+            .collect(),
+    );
+    let q = Mat::from_vec(
+        1,
+        N_STATE,
+        (0..N_STATE).map(|_| 0.1 * lcg.next_f32()).collect(),
+    );
+    let k_new = Mat::from_vec(
+        1,
+        N_STATE,
+        (0..N_STATE).map(|_| 0.1 * lcg.next_f32()).collect(),
+    );
+    let v_new = Mat::from_vec(
+        1,
+        N_STATE,
+        (0..N_STATE).map(|_| 0.1 * lcg.next_f32()).collect(),
+    );
+
+    let mut original = KvCache::new(CAPACITY, N_STATE);
+    let mut candidate = KvCache::new_column_major_keys_for_bench(CAPACITY, N_STATE);
+    original
+        .append(&prefill_k, &prefill_v)
+        .expect("prefill original cache");
+    candidate
+        .append(&prefill_k, &prefill_v)
+        .expect("prefill packed cache");
+
+    let original_out =
+        attention_with_cache(&q, &k_new, &v_new, N_HEAD, &mut original).expect("original step");
+    original.truncate_for_bench(PREFILL);
+    let candidate_out =
+        attention_with_cache(&q, &k_new, &v_new, N_HEAD, &mut candidate).expect("candidate step");
+    candidate.truncate_for_bench(PREFILL);
+    assert_eq!(
+        original_out
+            .data
+            .iter()
+            .map(|value| value.to_bits())
+            .collect::<Vec<_>>(),
+        candidate_out
+            .data
+            .iter()
+            .map(|value| value.to_bits())
+            .collect::<Vec<_>>(),
+        "packed K layout changed attention output"
+    );
+
+    let measure = |cache: &mut KvCache| {
+        let started = std::time::Instant::now();
+        let output =
+            attention_with_cache(&q, &k_new, &v_new, N_HEAD, cache).expect("self-attention step");
+        let elapsed = started.elapsed();
+        black_box(output.data.as_slice());
+        cache.truncate_for_bench(PREFILL);
+        elapsed
+    };
+
+    for rep in 0..3 {
+        if rep % 2 == 0 {
+            black_box(measure(&mut original));
+            black_box(measure(&mut candidate));
+        } else {
+            black_box(measure(&mut candidate));
+            black_box(measure(&mut original));
+        }
+    }
+
+    let mut original_ns = Vec::with_capacity(PAIRED_REPS);
+    let mut candidate_ns = Vec::with_capacity(PAIRED_REPS);
+    let mut ratios = Vec::with_capacity(PAIRED_REPS);
+    for rep in 0..PAIRED_REPS {
+        let (orig, cand) = if rep % 2 == 0 {
+            (measure(&mut original), measure(&mut candidate))
+        } else {
+            let cand = measure(&mut candidate);
+            let orig = measure(&mut original);
+            (orig, cand)
+        };
+        let orig = orig.as_nanos();
+        let cand = cand.as_nanos();
+        original_ns.push(orig);
+        candidate_ns.push(cand);
+        ratios.push(orig as f64 / cand as f64);
+    }
+    let mean_ratio = ratios.iter().sum::<f64>() / ratios.len() as f64;
+    let ratio_variance = ratios
+        .iter()
+        .map(|ratio| (ratio - mean_ratio).powi(2))
+        .sum::<f64>()
+        / (ratios.len() - 1) as f64;
+    let cv_pct = ratio_variance.sqrt() / mean_ratio * 100.0;
+    let wins = ratios.iter().filter(|&&ratio| ratio > 1.0).count();
+    original_ns.sort_unstable();
+    candidate_ns.sort_unstable();
+    eprintln!(
+        "SELF_K_PAIRED reach=actual_attention_with_cache parity=bit_exact reps={PAIRED_REPS} \
+         orig_median_ns={} candidate_median_ns={} ratio={mean_ratio:.6} cv_pct={cv_pct:.3} \
+         candidate_wins={wins}/{PAIRED_REPS}",
+        original_ns[PAIRED_REPS / 2],
+        candidate_ns[PAIRED_REPS / 2]
+    );
+
+    let mut group = c.benchmark_group("native_engine/self_attn_k_layout");
+    group.sample_size(20);
+    group.warm_up_time(Duration::from_millis(500));
+    group.measurement_time(Duration::from_secs(2));
+    group.bench_function("orig_row_major", |b| {
+        b.iter(|| {
+            let output = attention_with_cache(&q, &k_new, &v_new, N_HEAD, &mut original)
+                .expect("original step");
+            black_box(output.data.as_slice());
+            original.truncate_for_bench(PREFILL);
+        });
+    });
+    group.bench_function("candidate_column_major", |b| {
+        b.iter(|| {
+            let output = attention_with_cache(&q, &k_new, &v_new, N_HEAD, &mut candidate)
+                .expect("candidate step");
+            black_box(output.data.as_slice());
+            candidate.truncate_for_bench(PREFILL);
+        });
+    });
+    group.finish();
+}

+
+/// Select the batched-f16-GEMV scheduler. **Default on** = the shipped row-morsel path.
+///
+/// `gemv_f16_batch` has two schedulers, both proven bit-identical to per-token `gemv_f16`
+/// (`gemv_f16_batch_equals_per_token_gemv`, `gemv_f16_batch_row_morsel_equals_per_token_gemv`),
+/// so this knob **cannot change results** — only scheduling:
+/// * **column-band** (`compute_band`, o-outer): each weight row is fetched once and dotted
+///   against all `tq` tokens ⇒ the weight is streamed **once**. Arithmetic intensity `tq`
+///   flop per weight byte.
+/// * **row-morsel** (`gemv_f16_batch_rows`, t-outer per band): every band re-streams the
+///   **whole** weight ⇒ one pass per band. Intensity `tq / workers`. It wins only when the
+///   shape is compute-bound enough that the extra weight traffic is free (cross-K/V:
+///   weight 3.3 MB, 2.4 GFLOP), and it carries the M2col cvtph-halving tile — which itself
+///   requires `row_band >= 2`, i.e. `tq >= 2 * workers`.
+///
+/// This setter exists so a bench can flip the scheduler **inside one binary** and time the
+/// real `gemv_f16_batch` both ways. An env var is read once per process and cannot do that,
+/// and an A/B split across two process invocations is not admissible.
+pub fn set_batch_gemv_row_morsel(on: bool) {
+    batch_gemv_row_morsel_init();
+    BATCH_GEMV_ROW_MORSEL.store(on, std::sync::atomic::Ordering::Relaxed);
 }
 
